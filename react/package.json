{
  "name": "@pisti-paypiller/react",
  "version": "0.7.1",
  "description": "Pisti for React: provider, hooks, prebuilt sign-in, sign-up, user and organization components.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pisti-paypiller/pisti-sdks.git",
    "directory": "react"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    "./styles.css": "./styles.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "styles.css",
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "typescript": "7.0.2"
  }
}
